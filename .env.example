# Copy this file to .env (in this folder) and add your key. Never commit .env.
# The app also looks one folder up (../.env) if there is no .env here.
# All AI features call gpt-6-luna through Portkey (https://api.portkey.ai/v1).
PORTKEY_API_KEY=your-portkey-api-key-here
# OPENAI_API_KEY is not needed (everything runs on gpt-6-luna via Portkey)

# Optional
# GP_TODAY=2026-10-20          # pin "today" for a repeatable demo
# GP_TOOL_TRANSPORT=local       # call the agent tools in-process instead of through the MCP server
